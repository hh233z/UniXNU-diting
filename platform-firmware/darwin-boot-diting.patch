+++ b/Platforms/Xiaomi/DarwinBootPkg/Driver/DarwinBoot.c
@@ -953,7 +953,7 @@ DarwinBootEntry (EFI_HANDLE ImageHandle, EFI_SYSTEM_TABLE *SystemTable)
       mReplacedLoader = Existing;
       mImage = ImageHandle;
       Loaded->Unload = Unload;
-      Print (L"DARWINBOOT: replaced loader in RAM; Darwin 22 ABI, EL%u\n", (UINT32)(DarwinCurrentEl () >> 2));
+      Print (L"DARWINBOOT: replaced loader in RAM; Darwin 24 ABI, EL%u\n", (UINT32)(DarwinCurrentEl () >> 2));
     }
     FreePool (Handles);
     return Status;
@@ -963,7 +963,7 @@ DarwinBootEntry (EFI_HANDLE ImageHandle, EFI_SYSTEM_TABLE *SystemTable)
   Status = gBS->InstallMultipleProtocolInterfaces (&ImageHandle, &gUniXNULoaderProtocolGuid, &mLoader, NULL);
   if (!EFI_ERROR (Status)) {
     Loaded->Unload = Unload;
-    Print (L"DARWINBOOT: Darwin 22 loader installed EL%u\n", (UINT32)(DarwinCurrentEl () >> 2));
+    Print (L"DARWINBOOT: Darwin 24 loader installed EL%u\n", (UINT32)(DarwinCurrentEl () >> 2));
   }
   return Status;
 }
