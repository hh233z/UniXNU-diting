/dts-v1/;
/include/ "sm8475.dtsi"
/ {
    model = "Diting based on Qualcomm Technologies, Inc SM8475";
    compatible = "xiaomi,diting", "qcom,cape-mtp", "qcom,cape", "qcom,mtp";
    qcom,msm-id = <0x213 0x10000 0x21c 0x10000 0x212 0x10000>;
    qcom,board-id = <0x10008 0x00>;
    xiaomi,miboard-id = <0x0a 0x00>;
    interrupt-parent = <&gic>;

    /* 此节点供现有 ADT 生成器读取容量。原厂启动时内存并不连续；
       当前单段声明是构建占位，实际内存范围和保留区仍需核实。 */
    memory@80000000 { device_type = "memory"; reg = <0x0 0x80000000 0x3 0x0>; };
    reserved-memory {
        #address-cells = <2>;
        #size-cells = <2>;
        ranges;
        region0@80000000 { reg = <0x0 0x80000000 0x0 0x600000>; no-map; };
        region1@80600000 { reg = <0x0 0x80600000 0x0 0x40000>; no-map; };
        region2@80800000 { reg = <0x0 0x80800000 0x0 0x60000>; no-map; };
        region3@80860000 { reg = <0x0 0x80860000 0x0 0x20000>; no-map; };
        region4@80880000 { reg = <0x0 0x80880000 0x0 0x20000>; no-map; };
        region5@808a0000 { reg = <0x0 0x808a0000 0x0 0x40000>; no-map; };
        region6@808e0000 { reg = <0x0 0x808e0000 0x0 0x4000>; no-map; };
        region7@808e4000 { reg = <0x0 0x808e4000 0x0 0x10000>; no-map; };
        region8@80900000 { reg = <0x0 0x80900000 0x0 0x200000>; no-map; };
        region9@80b00000 { reg = <0x0 0x80b00000 0x0 0x100000>; no-map; };
        region10@80c00000 { reg = <0x0 0x80c00000 0x0 0x4600000>; no-map; };
        region11@85700000 { reg = <0x0 0x85700000 0x0 0x700000>; no-map; };
        region12@88000000 { reg = <0x0 0x88000000 0x0 0x1900000>; no-map; };
        region13@89900000 { reg = <0x0 0x89900000 0x0 0x2000000>; no-map; };
        region14@8b900000 { reg = <0x0 0x8b900000 0x0 0x10000>; no-map; };
        region15@8b910000 { reg = <0x0 0x8b910000 0x0 0xa000>; no-map; };
        region16@8b91a000 { reg = <0x0 0x8b91a000 0x0 0x2000>; no-map; };
        region17@8ba00000 { reg = <0x0 0x8ba00000 0x0 0x180000>; no-map; };
        region18@8bb80000 { reg = <0x0 0x8bb80000 0x0 0x60000>; no-map; };
        region19@8bbe0000 { reg = <0x0 0x8bbe0000 0x0 0x20000>; no-map; };
        region20@8bc00000 { reg = <0x0 0x8bc00000 0x0 0x13200000>; no-map; };
        region21@9ee00000 { reg = <0x0 0x9ee00000 0x0 0x700000>; no-map; };
        region22@9f500000 { reg = <0x0 0x9f500000 0x0 0x800000>; no-map; };
        region23@9fd00000 { reg = <0x0 0x9fd00000 0x0 0x3100000>; no-map; };
        region24@a6b80000 { reg = <0x0 0xa6b80000 0x0 0x280000>; no-map; };
        region25@a6e00000 { reg = <0x0 0xa6e00000 0x0 0x40000>; no-map; };
        region26@a6f00000 { reg = <0x0 0xa6f00000 0x0 0x100000>; no-map; };
        region27@e0000000 { reg = <0x0 0xe0000000 0x0 0x600000>; no-map; };
        region28@e0600000 { reg = <0x0 0xe0600000 0x0 0x400000>; no-map; };
        region29@e0a00000 { reg = <0x0 0xe0a00000 0x0 0x100000>; no-map; };
        region30@e55f3000 { reg = <0x0 0xe55f3000 0x0 0x9000>; no-map; };
        region31@e55fc000 { reg = <0x0 0xe55fc000 0x0 0x4000>; no-map; };
        region32@e5600000 { reg = <0x0 0xe5600000 0x0 0x100000>; no-map; };
        region33@e8800000 { reg = <0x0 0xe8800000 0x0 0x100000>; no-map; };
        region34@e8900000 { reg = <0x0 0xe8900000 0x0 0x1200000>; no-map; };
        region35@e9b00000 { reg = <0x0 0xe9b00000 0x0 0x500000>; no-map; };
        splash_region: splash_region@b8000000 { reg = <0x0 0xb8000000 0x0 0x2b00000>; no-map; };
        ramoops@a7000000 { reg = <0x0 0xa7000000 0x0 0x400000>; no-map; };
    };
};

/* 与本机运行时设备树中的 TLMM 中断控制器配置一致。 */
&tlmm {
    interrupt-controller;
    #interrupt-cells = <2>;
    interrupt-parent = <&gic>;
    interrupts = <0 0xd0 4>;
};

/* Board nodes from dtbo-02-0x0-r0.dtb (Redmi K50 Ultra), merged over the
   stock vendor_boot DTB. SoC containers (GENI SPI, MDSS, pmic_glink) are
   placeholders: only the board children are reproduced. */
&apss {
    spi@990000 {
        compatible = "qcom,spi-geni";
        reg = <0x0 0x990000 0x0 0x4000>;
        reg-names = "se_phys";
        #address-cells = <1>;
        #size-cells = <0>;
        qcom,rt;
        xiaomi_touch@0 {
            fts,touch-expert-array = <0x06 0x0f 0x01 0x82 0x08 0x12 0x02 0x0f 0x01 0x82 0x05 0x12 0x04 0x0f 0x01 0x82 0x04 0x12>;
            fts,touch-tap-stability = <0x0a 0x0e 0x12 0x14 0x1a>;
            fts,touch-aim-sensitivity = <0x0c 0x0a 0x08 0x06 0x04>;
            fts,touch-tap-sensitivity = <0xa0 0x96 0x8c 0x82 0x64>;
            fts,touch-follow-performance = <0x0a 0x0f 0x01 0x08 0x0f 0x01 0x06 0x0f 0x01 0x04 0x0f 0x01 0x02 0x0f 0x01>;
            fts,touch-normal-cornerzone-filter-hor2 = <0x00 0x00 0x405 0x00 0x4c3 0xbe 0x00 0x00 0x00 0x01 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x02 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x03 0x405 0x9d9 0x4c3 0xa97 0x00 0x00>;
            fts,touch-normal-cornerzone-filter-hor1 = <0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x01 0x00 0x00 0xbe 0xbe 0x00 0x00 0x00 0x02 0x00 0x9d9 0xbe 0xa97 0x00 0x00 0x00 0x03 0x00 0x00 0x00 0x00 0x00 0x00>;
            fts,touch-normal-edgezone-filter-hor = <0x01 0x00 0x00 0x00 0x4c3 0x28 0x00 0x00 0x01 0x01 0x00 0xa6f 0x4c3 0xa97 0x00 0x00 0x01 0x02 0x00 0x00 0x28 0xa97 0x00 0x00 0x01 0x03 0x49b 0x00 0x4c3 0xa97 0x00 0x00>;
            fts,touch-cornerzone-filter-hor2 = <0x00 0x00 0x405 0x00 0x4c3 0xbe 0x00 0x00 0x00 0x01 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x02 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x03 0x405 0x9d9 0x4c3 0xa97 0x00 0x00>;
            fts,touch-cornerzone-filter-hor1 = <0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x01 0x00 0x00 0xbe 0xbe 0x00 0x00 0x00 0x02 0x00 0x9d9 0xbe 0xa97 0x00 0x00 0x00 0x03 0x00 0x00 0x00 0x00 0x00 0x00>;
            fts,touch-cornerzone-filter-ver = <0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x01 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x02 0x00 0x944 0xa9 0xa97 0x00 0x00 0x00 0x03 0x41a 0x944 0x4c3 0xa97 0x00 0x00>;
            fts,touch-edgezone-filter-hor = <0x01 0x00 0x00 0x00 0x4c3 0x2a 0x00 0x00 0x01 0x01 0x00 0xa6d 0x4c3 0xa97 0x00 0x00 0x01 0x02 0x00 0x00 0x2a 0xa97 0x00 0x00 0x01 0x03 0x499 0x00 0x4c3 0xa97 0x00 0x00>;
            fts,touch-edgezone-filter-ver = <0x01 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x01 0x01 0x00 0x00 0x00 0x00 0x00 0x00 0x01 0x02 0x00 0x00 0x2a 0xa97 0x00 0x00 0x01 0x03 0x499 0x00 0x4c3 0xa97 0x00 0x00>;
            fts,touch-deadzone-filter-hor = <0x02 0x00 0x00 0x00 0x4c3 0x00 0x00 0x00 0x02 0x01 0x00 0xa97 0x4c3 0xa97 0x00 0x00 0x02 0x02 0x00 0x00 0x00 0xa97 0x00 0x00 0x02 0x03 0x4c3 0x00 0x4c3 0xa97 0x00 0x00>;
            fts,touch-deadzone-filter-ver = <0x02 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x02 0x01 0x00 0x00 0x00 0x00 0x00 0x00 0x02 0x02 0x00 0x00 0x00 0xa97 0x00 0x00 0x02 0x03 0x4c3 0x00 0x4c3 0xa97 0x00 0x00>;
            fts,cornerfilter-area-step3 = <0x118>;
            fts,cornerfilter-area-step2 = <0xbe>;
            fts,cornerfilter-area-step1 = <0x70>;
            fts,touch-tap-stability-def = <0x03>;
            fts,touch-aim-sensitivity-def = <0x03>;
            fts,touch-tap-sensitivity-def = <0x04>;
            fts,touch-follow-performance-def = <0x03>;
            fts,support-super-resolution = <0x01>;
            fts,config-array-size = <0x01>;
            fts,non-curved-display = <0x01>;
            fts,default-fw-name = "st_fts_l12.ftb";
            fts,fod-y-size = <0x8e8>;
            fts,fod-x-size = <0x8e8>;
            fts,fod-ly = <0x5b04>;
            fts,fod-lx = <0x1360>;
            fts,support-fod = <0x01>;
            fts,y-max = <0x69f0>;
            fts,x-max = <0x2fa8>;
            fts,irq-flags = <0x2008>;
            fts,reset-gpio-name = "fts_rst";
            fts,reset-gpio = <&tlmm 0x14 0x00>;
            fts,reset-gpio-enable;
            fts,irq-gpio-name = "fts_irq";
            fts,irq-gpio = <&tlmm 0x15 0x2008>;
            fts,bus-reg-name = "vdd";
            fts,avdd-gpio = <&tlmm 0x47 0x00>;
            goodix,touch-expert-array = <0x02 0x03 0x02 0x02 0x04 0x03 0x03 0x02 0x03 0x03 0x04 0x02>;
            goodix,config-name = "goodix_cfg_group_l12";
            goodix,firmware-name = "goodix_firmware_l12";
            goodix,panel-max-p = <0x1000>;
            goodix,panel-max-w = <0xff>;
            goodix,panel-max-y = <0x69f0>;
            goodix,panel-max-x = <0x2fa8>;
            goodix,irq-flags = <0x02>;
            goodix,reset-gpio = <&tlmm 0x14 0x00>;
            goodix,irq-gpio = <&tlmm 0x15 0x2008>;
            goodix,iovdd-name = "vdd";
            goodix,avdd-gpio = <&tlmm 0x47 0x00>;
            interrupts = <0x15 0x2008>;
            interrupt-parent = <&tlmm>;
            spi-max-frequency = <0xb71b00>;
            reg = <0x00>;
            compatible = "xiaomi,l12-spi";
            status = "ok";
            fts,cfg_0 {
                fts,limit-name = "stm_fts_production_limits.csv";
                fts,fw-name = "st_fts_l12.ftb";
                fts,tp-vendor = <0x38>;
            };
        };
    };

    qcom,mdss_mdp@ae00000 {
        compatible = "qcom,sde-kms";
        reg = <0x0 0xae00000 0x0 0x84000>,
              <0x0 0xaeb0000 0x0 0x2008>,
              <0x0 0xaeac000 0x0 0x800>;
        reg-names = "mdp_phys", "vbif_phys", "regdma_phys";
        qcom,mdss_dsi_l12_36_02_0b_dsc_cmd {
            qcom,mdss-dsi-panel-name = "xiaomi 36 02 0b mp cmd mode dsc dsi panel";
            qcom,mdss-dsi-panel-type = "dsi_cmd_mode";
            qcom,mdss-dsi-virtual-channel-id = <0x00>;
            qcom,mdss-dsi-stream = <0x00>;
            qcom,mdss-dsi-bpp = <0x1e>;
            qcom,mdss-dsi-color-order = "rgb_swap_rgb";
            qcom,mdss-dsi-underflow-color = <0xff>;
            qcom,mdss-dsi-border-color = <0x00>;
            qcom,dsi-ctrl-num = <0x00>;
            qcom,dsi-phy-num = <0x00>;
            qcom,mdss-dsi-traffic-mode = "burst_mode";
            qcom,mdss-dsi-lane-map = "lane_map_0123";
            qcom,mdss-dsi-bllp-eof-power-mode;
            qcom,mdss-dsi-bllp-power-mode;
            qcom,mdss-dsi-lane-0-state;
            qcom,mdss-dsi-lane-1-state;
            qcom,mdss-dsi-lane-2-state;
            qcom,mdss-dsi-lane-3-state;
            qcom,mdss-dsi-dma-trigger = "trigger_sw";
            qcom,mdss-dsi-mdp-trigger = "none";
            qcom,mdss-dsi-reset-sequence = <0x01 0x0b 0x00 0x01 0x01 0x14>;
            qcom,mdss-pan-physical-width-dimension = <0x2b7>;
            qcom,mdss-pan-physical-height-dimension = <0x609>;
            qcom,mdss-dsi-te-pin-select = <0x01>;
            qcom,mdss-dsi-wr-mem-start = <0x2c>;
            qcom,mdss-dsi-wr-mem-continue = <0x3c>;
            qcom,mdss-dsi-te-dcs-command = <0x01>;
            qcom,mdss-dsi-te-check-enable;
            qcom,mdss-dsi-te-using-te-pin;
            qcom,mdss-dsi-tx-eot-append;
            qcom,mdss-dsi-lp11-init;
            qcom,mdss-dsi-bl-inverted-dbv;
            qcom,bl-update-flag = "delay_until_first_frame";
            qcom,mdss-dsi-panel-mode-switch;
            qcom,mdss-dsi-panel-hdr-enabled;
            qcom,mdss-dsi-panel-hdr-color-primaries = <0x38a4 0x3c8c 0x7d00 0x4268 0x3c8c 0x7530 0x1f40 0xbb8>;
            qcom,mdss-dsi-panel-peak-brightness = <0x401640>;
            qcom,mdss-dsi-panel-blackness-level = <0xc9e>;
            qcom,mdss-dsi-dma-schedule-line = <0x01>;
            qcom,mdss-dsi-dma-schedule-window = <0x0a>;
            mi,panel-id = <0x4c3132 0x360200>;
            mi,esd-err-irq-gpio = <&tlmm 0x74 0x2008>;
            mi,thermal-dimming-flag;
            mi,panel-on-dimming-delay = <0x78>;
            mi,dimming-need-update-speed;
            mi,dimming-node = <0x00 0xc8 0x1c2 0x320 0xfff>;
            mi,max-brightness-clone = <0xfff>;
            mi,normal-max-brightness-clone = <0x7ff>;
            mi,mdss-dsi-fac-bl-max-level = <0x7ff>;
            mi,mdss-fac-brightness-max-level = <0x7ff>;
            mi,hbm-bl-min-level = <0x01>;
            mi,hbm-bl-max-level = <0x7ff>;
            mi,local-hbm-enabled;
            mi,local-hbm-white-1000nit-update-flag;
            mi,local-hbm-white-110nit-update-flag;
            mi,local-hbm-alpha-ctrl-aa-area;
            mi,local-hbm-ctrl-df-reg;
            mi,doze-hbm-dbv-level = <0xfc>;
            mi,doze-lbm-dbv-level = <0x14>;
            mi,ddic-round-corner-enabled;
            mi,fod-low-brightness-clone-threshold = <0xc8>;
            mi,fod-low-brightness-lux-threshold = <0x03>;
            mi,flat-update-flag;
            mi,flat-need-sync-te;
            mi,flat-need-update-gamma-zero;
            mi,local-hbm-ui-ready-delay-num-frame = <0x04>;
            qcom,mdss-dsi-bl-pmic-control-type = "bl_ctrl_dcs";
            qcom,mdss-dsi-bl-min-level = <0x01>;
            qcom,mdss-dsi-bl-max-level = <0xfff>;
            qcom,mdss-brightness-max-level = <0xfff>;
            qcom,platform-reset-gpio = <&tlmm 0x00 0x00>;
            qcom,ulps-enabled;
            qcom,dsi-select-clocks = "pll_byte_clk0", "pll_dsi_clk0";
            qcom,mdss-dsi-display-timings {
                timing@2 {
                    qcom,mdss-dsi-cmd-mode;
                    qcom,mdss-dsi-panel-framerate = <0x5a>;
                    qcom,mdss-dsi-panel-width = <0x4c4>;
                    qcom,mdss-dsi-panel-height = <0xa98>;
                    qcom,mdss-dsi-h-front-porch = <0x10>;
                    qcom,mdss-dsi-h-back-porch = <0x56>;
                    qcom,mdss-dsi-h-pulse-width = <0x10>;
                    qcom,mdss-dsi-h-sync-skew = <0x00>;
                    qcom,mdss-dsi-v-back-porch = <0x10>;
                    qcom,mdss-dsi-v-front-porch = <0x18>;
                    qcom,mdss-dsi-v-pulse-width = <0x04>;
                    qcom,mdss-dsi-h-sync-pulse = <0x00>;
                    qcom,mdss-dsi-h-left-border = <0x00>;
                    qcom,mdss-dsi-h-right-border = <0x00>;
                    qcom,mdss-dsi-v-top-border = <0x00>;
                    qcom,mdss-dsi-v-bottom-border = <0x00>;
                    qcom,mdss-dsi-panel-clockrate = <0x4190ab00>;
                    qcom,mdss-dsi-panel-jitter = <0x05 0x01>;
                    qcom,mdss-mdp-transfer-time-us = <0x1c84>;
                    qcom,mdss-dsi-on-command = [39 00 00 00 00 00 06 f0 55 aa 52 08 08 39 00 00 40 00 00 06 e0 41 73 73 73 83 39 00 00 40 00 00 16 e1 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 39 00 00 40 00 00 16 e2 80 ef 66 86 00 00 00 00 00 00 00 00 00 00 00 00 00 00 02 01 00 39 00 00 40 00 00 16 e3 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 39 00 00 40 00 00 13 e4 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 39 00 00 40 00 00 13 e5 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 39 00 00 00 00 00 13 e6 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 39 00 00 40 00 00 06 f0 55 aa 52 08 07 15 00 00 40 00 00 02 6f 37 39 00 00 40 00 00 04 b7 08 08 08 39 00 00 40 00 00 06 f0 55 aa 52 08 00 15 00 00 40 00 00 02 6f 37 39 00 00 40 00 00 04 b7 08 08 08 39 00 00 40 00 00 06 f0 55 aa 52 08 00 15 00 00 40 00 00 02 6f 01 15 00 00 40 00 00 02 c0 20 39 00 00 40 00 00 06 f0 55 aa 52 08 08 39 00 00 40 00 00 22 ea 02 00 e0 00 e0 70 00 70 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 15 00 00 40 00 00 02 6f 15 39 00 00 40 00 00 07 ea 00 00 80 00 80 00 39 00 00 40 00 00 06 f0 55 aa 52 08 08 15 00 00 40 00 00 02 6f 21 39 00 00 00 00 00 07 ea 00 00 00 00 00 00 39 00 00 40 00 00 06 f0 55 aa 52 08 08 15 00 00 40 00 00 02 e0 01 39 00 00 40 00 00 05 e2 42 ee 04 20 15 00 00 40 00 00 02 6f 12 39 00 00 40 00 00 03 e2 fd 03 39 00 00 40 00 00 09 ea 02 00 b8 00 b8 58 00 58 15 00 00 40 00 00 02 6f 17 39 00 00 00 00 00 04 ea 48 00 48 39 00 00 40 00 00 06 f0 55 aa 52 08 00 15 00 00 40 00 00 02 6f 13 15 00 00 00 00 00 02 b2 4f 39 00 00 40 00 00 05 ff aa 55 a5 81 15 00 00 40 00 00 02 6f 19 15 00 00 40 00 00 02 fb 00 15 00 00 40 00 00 02 6f 05 15 00 00 00 00 00 02 fe 34 39 00 00 40 00 00 05 ff aa 55 a5 80 15 00 00 40 00 00 02 6f 1a 15 00 00 40 00 00 02 f4 55 15 00 00 40 00 00 02 6f 0f 15 00 00 40 00 00 02 fc 00 15 00 00 40 00 00 02 6f 09 39 00 00 00 00 00 03 fc fc f0 39 00 00 40 00 00 05 ff aa 55 a5 83 15 00 00