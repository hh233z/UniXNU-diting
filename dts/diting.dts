                    mi,mdss-dsi-doze-hbm-nolp-command-state = "dsi_lp_mode";
                    mi,mdss-dsi-doze-lbm-nolp-command = [39 00 00 00 00 00 06 f0 55 aa 52 08 00 39 00 00 00 00 00 02 b2 98 39 00 00 40 00 00 02 65 00 39 00 00 40 32 00 01 38 39 00 00 40 00 00 05 51 00 14 0f fe 39 00 00 00 00 00 01 2c];
                    mi,mdss-dsi-doze-lbm-nolp-command-state = "dsi_lp_mode";
                    mi,mdss-dsi-flat-mode-on-command = <0x15000000 0x22f 0x2150000 0x60000002 0x5f003900 0x600000 0x6f055aa 0x52080015 0x6000 0x26f09 0x15000060 0x2c0 0x40390000 0x60000006 0xf055aa52 0x8021500 0x600000 0x2cc3015 0x2014 0x2ce01>;
                    mi,mdss-dsi-flat-mode-on-command-state = "dsi_lp_mode";
                    mi,mdss-dsi-flat-mode-on-sec-command = [39 00 00 00 00 00 06 f0 55 aa 52 08 02 15 00 00 00 00 00 02 cc 00];
                    mi,mdss-dsi-flat-mode-on-sec-command-state = "dsi_lp_mode";
                    mi,mdss-dsi-flat-mode-off-command = <0x15000000 0x22f 0x2150000 0x60000002 0x5f013900 0x600000 0x6f055aa 0x52080015 0x6000 0x26f09 0x15000060 0x2c0 0x390000 0x60000006 0xf055aa52 0x8021500 0x600000 0x2cc3015 0x2014 0x2ce01>;
                    mi,mdss-dsi-flat-mode-off-command-state = "dsi_lp_mode";
                    mi,mdss-dsi-flat-mode-off-sec-command = [39 00 00 00 00 00 06 f0 55 aa 52 08 02 15 00 00 00 00 00 02 cc 00];
                    mi,mdss-dsi-flat-mode-off-sec-command-state = "dsi_lp_mode";
                    mi,mdss-dsi-round-corner-on-command = [39 00 00 00 00 00 06 f0 55 aa 52 08 07 39 00 00 00 00 00 02 c0 01];
                    mi,mdss-dsi-round-corner-on-command-state = "dsi_lp_mode";
                    mi,mdss-dsi-round-corner-off-command = [39 00 00 00 00 00 06 f0 55 aa 52 08 07 39 00 00 00 00 00 02 c0 00];
                    mi,mdss-dsi-round-corner-off-command-state = "dsi_lp_mode";
                    qcom,mdss-dsi-panel-phy-timings = [00 24 0a 0a 1a 25 09 0a 09 02 04 00 1e 0f];
                    qcom,display-topology = <0x02 0x02 0x01>;
                    qcom,default-topology-index = <0x00>;
                };
            };
        };
    };

    fingerprint_goodix {
        status = "ok";
        goodix,gpio-irq = <&tlmm 0x28 0x00>;
        goodix,gpio-reset = <&tlmm 0x29 0x00>;
        compatible = "goodix,fingerprint";
    };

    ssusb@a600000 {
        usb-role-switch;
        compatible = "qcom,dwc-usb3-msm";
        reg = <0x0 0xa600000 0x0 0x100000>;
        reg-names = "core_base";
        #address-cells = <0x01>;
        #size-cells = <0x01>;
        ranges = <0xa600000 0x0 0xa600000 0x100000>;
        qcom,use-pdc-interrupts;
        qcom,use-eusb2-phy;
        qcom,dis-sending-cm-l1-quirk;
        qcom,core-clk-rate = <0xbebc200>;
        qcom,core-clk-rate-disconnected = <0x7f28155>;
        qcom,core-clk-rate-hs = <0x3f940ab>;
        qcom,pm-qos-latency = <0x02>;
        qcom,num-gsi-evt-buffs = <0x03>;
        qcom,gsi-reg-offset = <0xfc 0x110 0x120 0x130 0x144 0x1a4>;
        dwc3@a600000 {
            usb-role-switch;
            compatible = "snps,dwc3";
            reg = <0xa600000 0xd93c>;
            qcom,iommu-dma = "atomic";
            qcom,iommu-dma-addr-pool = <0x90000000 0x60000000>;
            dma-coherent;
            interrupts = <0x00 0x85 0x04>;
            snps,disable-clk-gating;
            snps,has-lpm-erratum;
            snps,hird-threshold = [00];
            snps,is-utmi-l1-suspend;
            snps,usb2-gadget-lpm-disable;
            snps,dis_u2_susphy_quirk;
            snps,dis_u3_susphy_quirk;
            snps,ssp-u3-u0-quirk;
            tx-fifo-resize;
            dr_mode = "otg";
            maximum-speed = "high-speed";
        };
    };

    qcom,pmic_glink {
        compatible = "qcom,pmic-glink";
        qcom,pmic-glink-channel = "PMIC_RTR_ADSP_APPS";
        qcom,subsys-name = "lpass";
        qcom,protection-domain = "tms/servreg", "msm/adsp/charger_pd";
        qcom,battery_charger {
            qcom,shutdown-voltage = <0xd16>;
            qcom,wireless-fw-name = "idt9415.bin";
            qcom,thermal-mitigation = <0x2dc6c0 0x16e360 0xf4240 0x7a120>;
            compatible = "qcom,battery-charger";
        };
    };
};

/* UFS: the ADT generator reads three board properties from this node
   (make-diting-adt-ipados18.py: pong,gcc-ufs-page, pong,smmu-stream-id, pong,ufs-spi).
   Values cross-checked against the stock diting tree (merged /soc/ufshc@1d84000):
   interrupts = <0x00 0x109 0x04> gives SPI 265, iommus = <.. 0xe0 ..> gives stream id
   0xe0, and 0x187000 is the SM8475 GCC UFS page register the Pong port uses. */
&ufs {
    status = "okay";
    reg = <0x0 0x1d84000 0x0 0x3000>,
          <0x0 0x1d88000 0x0 0x8000>,
          <0x0 0x1d90000 0x0 0x9000>;
    reg-names = "ufs_mem", "ufs_ice", "ufs_ice_hwkm";
    interrupt-parent = <&gic>;
    interrupts = <0 0x109 4>;
    /* 当前 NativeUfs 轮询完成；标准中断映射待完整验证。 */
    unixnu,adt-no-interrupts;
    unixnu,adt-u64 = "pong,ufs-hc-base", "pong,ufs-hc-size", "pong,gcc-ufs-page",
                     "pong,smmu-base", "pong,smmu-size";
    unixnu,adt-u32 = "pong,smmu-stream-id", "pong,smmu-context-banks",
                     "pong,smmu-match-groups", "pong,ufs-spi";
    pong,ufs-hc-base = /bits/ 64 <0x1d84000>;
    pong,ufs-hc-size = /bits/ 64 <0x3000>;
    pong,gcc-ufs-page = /bits/ 64 <0x187000>;
    pong,smmu-stream-id = <0xe0>;
    pong,smmu-base = /bits/ 64 <0x15000000>;
    pong,smmu-size = /bits/ 64 <0x100000>;
    pong,smmu-context-banks = <78>;
    /* 该值继承自同 SoC 的 Pong，尚未通过 Diting 寄存器核实。 */
    pong,smmu-match-groups = <120>;
    pong,ufs-spi = <265>;
};
