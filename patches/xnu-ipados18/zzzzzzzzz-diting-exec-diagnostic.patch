+
+static bool
+diting_exec_diag_emit(uint32_t *count)
+{
+	proc_t caller = current_proc();
+	if (!diting_exec_diag || !caller) {
+		return false;
+	}
+	const char *const names[] = {"xpcproxy", "timed", "sharingd", "ptpd", "logd",
+	    "accountsd", "tccd", "contextstored"};
+	bool match = false;
+	for (unsigned i = 0; i < sizeof(names) / sizeof(names[0]); i++) {
+		if (strcmp(caller->p_comm, names[i]) == 0) {
+			match = true;
+			break;
+		}
+	}
+	if (!match) return false;
+	return __atomic_fetch_add(count, 1, __ATOMIC_RELAXED) < 8;
+}
