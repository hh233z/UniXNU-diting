From: diting-port <diting@local>
Subject: [PATCH] diting: print the ramoops mapping result

Only report the result; no extra API calls, so the build cannot change
behaviour beyond one console line.

---
--- a/osfmk/arm64/diting_ramoops_console.h
+++ b/osfmk/arm64/diting_ramoops_console.h
@@ -124,6 +124,9 @@
 	}
 	vm_offset_t mapped = ml_io_map_wcomb(DITING_RAMOOPS_PHYS_BASE,
 	    DITING_RAMOOPS_RESERVED_BYTES);
+	printf("DITING RAMOOPS: base=%#lx size=%#lx mapped=%p\n",
+	    (unsigned long)DITING_RAMOOPS_PHYS_BASE,
+	    (unsigned long)DITING_RAMOOPS_RESERVED_BYTES, (void *)mapped);
 	if (!mapped) {
 		return 0;
 	}
